{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PointHub": ""
  },
  "Database": {
    "AutoMigrate": false,
    "SeedDevData": false
  },
  "Auth": {
    "Mode": "EntraId",
    "BootstrapAdminEmails": [],
    "AutoCreateEmployees": true,
    "EntraId": {
      "TenantId": "",
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "EmailClaim": "email",
      "EmployeeNoClaim": "employeeid"
    },
    "Windows": {
      "UseDirectoryLookup": true,
      "EmailDomain": "",
      "AllowedDomains": []
    }
  },
  "CheckIn": {
    "RotatingPeriodSeconds": 30,
    "RotatingGraceSteps": 2
  },
  "Integration": {
    "RequestsPerMinute": 120
  },
  "Site": {
    "AppName": "PointHub",
    "PublicBaseUrl": "",
    "PathBase": "",
    "DefaultLocale": "en",
    "TimeZone": "Asia/Taipei"
  },
  "Uploads": {
    "AssetsPath": "uploads/assets",
    "MaxImageMegabytes": 8
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "PointHub",
    "TimeoutSeconds": 15,
    "PollSeconds": 10
  }
}
